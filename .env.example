# MongoDB Atlas (hackathon sandbox) connection string.
# Local dev: `docker compose up -d` and leave this as-is.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
RECEIPTS_DB=receipts

# Decisions. With a key set, the agent uses Claude; without one it falls back
# to a deterministic rule-based stub so the whole pipeline still runs offline.
ANTHROPIC_API_KEY=
RECEIPTS_MODEL=claude-opus-5-5
RECEIPTS_EFFORT=low
# auto | claude | stub
RECEIPTS_BRAIN=auto

# Embeddings. With a key set, Voyage; without one, a local hashing embedder
# (lexical only - fine for the demo, not for production).
# Switching embedders requires re-seeding: `python -m scripts.seed`
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
VOYAGE_BASE_URL=https://api.voyageai.com/v1
